{
  "private": true,
  "scripts": {
    "lint:md": "markdownlint-cli2 && textlint README.md CHANGELOG.md \"docs/**/*.md\" \"plugins/**/*.md\"",
    "lint:md:style": "markdownlint-cli2",
    "lint:md:text": "textlint",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:uninstall": "git config --unset core.hooksPath || true"
  },
  "devDependencies": {
    "@textlint-ja/textlint-rule-preset-ai-writing": "1.7.2",
    "markdownlint-cli2": "0.24.2",
    "textlint": "16.1.3"
  }
}
